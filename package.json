{
  "name": "abai-arcane-duel",
  "version": "1.0.0",
  "private": true,
  "description": "ABAI 祕法對決 — a five-colour trading card game played on a three.js board, built to a single offline HTML file.",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build -c vite.single.config.ts",
    "build:hook": "node tools/build-hook.mjs",
    "build:tuner": "npm run build && node tools/build-tuner.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:hook && node tests/run.mjs",
    "clean": "rm -rf dist dist-single dist-hook"
  },
  "dependencies": {
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
